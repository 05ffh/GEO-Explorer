# =============================================================================
# GEO Explorer — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                            # development | production
SECRET_KEY=change-me                           # 生产环境须改（config fail-fast 校验）

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://geo:geo@localhost:5432/geo_explorer
TEST_DATABASE_URL=postgresql+asyncpg://geo_test:geo_test@localhost:5433/geo_explorer_test

# ── AI Platforms（四平台联网诊断 src/adapters/*）─────────────────────────────
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

KIMI_API_KEY=sk-your-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

DOUBAO_API_KEY=your-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-lite-260428

WENXIN_API_KEY=your-key
WENXIN_SECRET_KEY=your-secret
WENXIN_BASE_URL=https://aip.baidubce.com
WENXIN_BASE_URL_V2=https://qianfan.baidubce.com/v2
WENXIN_MODEL=ernie-4.0-turbo-128k

# ── 采集 ─────────────────────────────────────────────────────────────────────
COLLECTOR_QUERY_TIMEOUT_SECONDS=60             # 单题超时(秒)

# ── Search（两路：Tavily + 豆包搜索；DDG 已于 2026-10-14 移除）────────────────
GT_SEARCH_TAVILY_ENABLED=true
GT_SEARCH_DOUBAO_ENABLED=true
TAVILY_API_KEY=tvly-your-key                   # GT 验证主源 — 必填
DOUBAO_SEARCH_API_KEY=your-key
SEARCH_MAX_RETRIES=2
