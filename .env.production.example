# =============================================================================
# GEO Explorer — Production Environment Template
# Copy to .env.production and fill in real values. NEVER commit.
# 生产环境 SECRET_KEY / *_API_KEY 必须非默认值（config fail-fast 校验）。
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://geo:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/geo_explorer
TEST_DATABASE_URL=postgresql+asyncpg://geo_test:REPLACE_WITH_STRONG_PASSWORD@localhost:5433/geo_explorer_test

# ── AI Platforms ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
KIMI_API_KEY=
DOUBAO_API_KEY=
WENXIN_API_KEY=
WENXIN_SECRET_KEY=

# ── Search（两路：Tavily + 豆包搜索）─────────────────────────────────────────
GT_SEARCH_TAVILY_ENABLED=true
GT_SEARCH_DOUBAO_ENABLED=true
TAVILY_API_KEY=
DOUBAO_SEARCH_API_KEY=
